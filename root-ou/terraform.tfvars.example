account_emails = {
  log_archive = "aws+log-archive@example.com"
  audit       = "aws+audit@example.com"
  test        = "aws+test@example.com"
  development = "aws+development@example.com"
  production  = "aws+production@example.com"
}

allowed_regions  = ["ap-northeast-1", "us-east-1"]
security_regions = ["ap-northeast-1"]

tag_rules = {
  Project = {}
  ManagedBy = {
    values = ["terraform", "manual"]
  }
}
